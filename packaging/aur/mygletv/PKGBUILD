# Maintainer: Ruancbardt <ruan.c.bardt@gmail.com>
pkgname=mygletv
pkgver=0.1.1
pkgrel=1
pkgdesc='Private screen sharing rooms with per-application audio'
arch=('x86_64')
url='https://github.com/amiltoromagno/MygleTV'
# The upstream repository does not currently declare an application license.
license=('unknown')
depends=('electron44' 'libpulse')
makedepends=('npm')
optdepends=('pipewire-pulse: audio capture with PipeWire'
            'pulseaudio: audio capture with PulseAudio'
            'xdg-desktop-portal: screen capture on Wayland')
options=('!strip')
source=("mygletv-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        'mygletv'
        'mygletv.desktop')
sha256sums=('9414a6a45cde8206240dbd10d356e6903a8d0866b683f80cb4ed377bc701da43'
            '69c2afabc1bbaffbb2d9d179e9573fc84094c6bd4361af1882fb212a3eb40791'
            '54993675c41195276f18ff5829e754672fb64c69c4d1b5c6a535d53b0db7137f')

build() {
  export npm_config_cache="${srcdir}/npm-cache"
  cd "${srcdir}/MygleTV-${pkgver}/screenroom"
  npm ci --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund
  cd "${srcdir}/MygleTV-${pkgver}/screenroom-desktop"
  npm ci --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund
}

package() {
  local project="${srcdir}/MygleTV-${pkgver}"
  local app="${pkgdir}/usr/lib/mygletv/app"
  local web="${pkgdir}/usr/lib/mygletv/screenroom"
  install -d "${app}" "${web}"
  install -m644 "${project}/screenroom-desktop/"*.js "${project}/screenroom-desktop/"*.cjs \
    "${project}/screenroom-desktop/package.json" "${app}/"
  cp -a "${project}/screenroom-desktop/audio" "${project}/screenroom-desktop/packaging" \
    "${project}/screenroom-desktop/node_modules" "${app}/"
  install -m644 "${project}/screenroom/server.js" "${project}/screenroom/package.json" "${web}/"
  cp -a "${project}/screenroom/public" "${project}/screenroom/node_modules" "${web}/"
  find "${pkgdir}" -name .package-lock.json -delete
  install -Dm755 "${srcdir}/mygletv" "${pkgdir}/usr/bin/mygletv"
  install -Dm644 "${srcdir}/mygletv.desktop" "${pkgdir}/usr/share/applications/mygletv.desktop"
  install -Dm644 "${project}/screenroom-desktop/packaging/mygletv-512.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/mygletv.png"
}
